# Copy this file to .env and fill in your real values. Never commit .env itself.

# From Supabase: Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@YOUR-PROJECT-REF.supabase.co:5432/postgres

# From Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Which Gemini model to use for everything (chat, generation, tagging, etc).
# Change this line to upgrade models later -- no code changes needed.
GEMINI_MODEL=gemini-3-flash-preview

# Only needed on Windows if Tesseract OCR isn't auto-detected on PATH.
# See SETUP.md Step 5 for installation.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
